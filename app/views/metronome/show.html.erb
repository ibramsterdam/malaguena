<% content_for :title, "Metronome · Malagueña" %>
<p class="eyebrow">Keep time</p>
<h1>Metronome</h1>

<div class="card metro" data-controller="metronome" data-metronome-bpm-value="80">
  <div class="metro-readout">
    <span class="metro-bpm" data-metronome-target="bpm">80</span>
    <span class="metro-unit">BPM</span>
  </div>

  <div class="metro-dots" aria-hidden="true">
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
  </div>

  <div class="metro-controls">
    <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="-5">−5</button>
    <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="-1">−1</button>
    <button class="btn metro-toggle" data-metronome-target="toggle" data-action="metronome#toggle">Start</button>
    <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="1">+1</button>
    <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="5">+5</button>
  </div>

  <label for="metro-slider" class="visually-hidden">Tempo</label>
  <input id="metro-slider" type="range" min="30" max="240" step="1" value="80"
         data-metronome-target="slider" data-action="input->metronome#slide">
</div>
