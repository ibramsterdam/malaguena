<% content_for :title, "#{@tab.title} · Malagueña" %>
<p class="eyebrow">Tab</p>
<h1><%= @tab.title %></h1>
<p class="muted"><%= @tab.default_bpm %> BPM</p>

<div class="engraved" data-controller="tab-player">
  <pre class="tab-sheet" data-tab-player-target="sheet"><%= @tab.body %></pre>
</div>

<div class="card dial tab-metro" data-controller="metronome" data-metronome-bpm-value="<%= @tab.default_bpm %>">
  <span class="dial-label">Play along</span>
  <span class="dial-big"><span data-metronome-target="bpm"><%= @tab.default_bpm %></span> <small>BPM</small></span>
  <div class="metro-dots dial-dots" aria-hidden="true">
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
    <i data-metronome-target="dot"></i>
  </div>
  <div class="toolbar" style="margin: 0;">
    <button class="btn btn-ghost dial-toggle" data-action="metronome#nudge" data-metronome-amount-param="-5">−5</button>
    <button class="btn dial-toggle" data-metronome-target="toggle" data-action="metronome#toggle">Start</button>
    <button class="btn btn-ghost dial-toggle" data-action="metronome#nudge" data-metronome-amount-param="5">+5</button>
  </div>
</div>

<div class="toolbar">
  <%= link_to "Edit", edit_tab_path(@tab), class: "btn-ghost btn" %>
  <%= button_to "Delete", @tab, method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "Delete #{@tab.title}?" } %>
  <span class="spacer"></span>
  <%= link_to "All tabs", tabs_path, class: "muted" %>
</div>
