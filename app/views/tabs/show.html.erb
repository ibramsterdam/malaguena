<% content_for :title, "#{@tab.title} · Malagueña" %>
<p class="eyebrow">Tab</p>
<h1><%= @tab.title %></h1>
<p class="muted"><%= @tab.default_bpm %> BPM</p>

<div class="engraved" data-controller="tab-player">
  <pre class="tab-sheet" data-tab-player-target="sheet"><%= @tab.body %></pre>
</div>
<div class="toolbar">
  <span class="spacer"></span>
  <%= link_to "All tabs", tabs_path, class: "muted" %>
</div>

<div class="play-bar" data-controller="metronome transport" data-metronome-bpm-value="<%= @tab.default_bpm %>">
  <span class="play-bar-label">Play along</span>
  <span class="play-bar-bpm"><span data-metronome-target="bpm"><%= @tab.default_bpm %></span> <small>BPM</small></span>
  <div class="metro-dots play-bar-dots" data-metronome-target="dots" aria-hidden="true"></div>
  <button class="btn btn-ghost" title="Restart" aria-label="Restart"
          data-action="transport#send" data-transport-action-param="restart">⟲</button>
  <button class="btn btn-ghost" title="Back a note" aria-label="Back a note"
          data-action="transport#send" data-transport-action-param="back">‹</button>
  <button class="btn btn-ghost" title="Forward a note" aria-label="Forward a note"
          data-action="transport#send" data-transport-action-param="forward">›</button>
  <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="-5">−5</button>
  <button class="btn" data-metronome-target="toggle" data-action="metronome#toggle">Start</button>
  <button class="btn btn-ghost" data-action="metronome#nudge" data-metronome-amount-param="5">+5</button>
  <button class="btn btn-ghost" hidden data-transport-target="clear"
          data-action="transport#send" data-transport-action-param="clearloop">✕ loop</button>
</div>
