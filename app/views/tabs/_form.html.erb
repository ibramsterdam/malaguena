<%= form_with model: tab do |f| %>
  <% if tab.errors.any? %>
    <div class="form-errors">
      Couldn't save this tab:
      <ul>
        <% tab.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field-row">
    <div class="field" style="flex: 3 1 240px;">
      <%= f.label :title %>
      <%= f.text_field :title, placeholder: "Malagueña" %>
    </div>
    <div class="field">
      <%= f.label :default_bpm, "Default BPM" %>
      <%= f.number_field :default_bpm, min: 20, max: 300 %>
    </div>
  </div>

  <div class="field">
    <%= f.label :body, "ASCII tab" %>
    <%= f.text_area :body, class: "tab-input", spellcheck: false,
          placeholder: "E|----------|\nB|-------0--|\nG|----1-----|\nD|--2-------|\nA|----------|\nE|----------|" %>
  </div>

  <div class="toolbar">
    <%= f.submit tab.persisted? ? "Save tab" : "Add tab", class: "btn" %>
    <%= link_to "Cancel", tab.persisted? ? tab_path(tab) : tabs_path, class: "btn btn-ghost" %>
  </div>
<% end %>
