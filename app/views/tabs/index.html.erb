<% content_for :title, "Tabs · Malagueña" %>
<p class="eyebrow">Library</p>
<h1>Tabs</h1>

<div class="toolbar">
  <span class="muted"><%= pluralize(@tabs.size, "tab") %></span>
</div>

<% if @tabs.any? %>
  <ul class="card-list">
    <% @tabs.each do |tab| %>
      <li>
        <%= link_to tab, class: "card tab-row" do %>
          <span class="tab-title"><%= tab.title %></span>
          <span class="muted"><%= tab.default_bpm %> BPM</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="muted">Nothing here yet — paste your first ASCII tab.</p>
<% end %>
