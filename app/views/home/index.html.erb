<p class="eyebrow">Practice tool</p>
<h1>Buenas, Bram</h1>
<p class="muted">Tune up, set a tempo, and get to work.</p>

<div class="home-cards">
  <%= link_to routines_path, class: "card" do %>
    <h3>Routines</h3>
    <p>Timed practice sessions, segment by segment.</p>
  <% end %>
  <%= link_to tabs_path, class: "card" do %>
    <h3>Tabs</h3>
    <p>Your ASCII tab library, on the engraved panel.</p>
  <% end %>
  <%= link_to metronome_path, class: "card" do %>
    <h3>Metronome</h3>
    <p>Drift-free clicks from the audio clock.</p>
  <% end %>
  <%= link_to tuner_path, class: "card" do %>
    <h3>Tuner</h3>
    <p>Pluck a string, land on the note.</p>
  <% end %>
</div>
