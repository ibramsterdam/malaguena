<% content_for :title, "Tuner · Malagueña" %>
<p class="eyebrow">Tune up</p>
<h1>Tuner</h1>

<div class="card tuner" data-controller="tuner">
  <div class="tuner-note" data-tuner-target="note">—</div>
  <div class="tuner-cents" data-tuner-target="cents">Play any string.</div>

  <div class="tuner-gauge" aria-hidden="true">
    <span class="tuner-mark flat">♭</span>
    <div class="tuner-track">
      <i class="tuner-center"></i>
      <i class="tuner-needle" data-tuner-target="needle"></i>
    </div>
    <span class="tuner-mark sharp">♯</span>
  </div>

  <div class="tuner-head">
    <svg class="tuner-art" viewBox="20 0 220 340" aria-hidden="true">
      <defs>
        <linearGradient id="ebony" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2B2018"/>
          <stop offset="0.5" stop-color="#1C130C"/>
          <stop offset="1" stop-color="#241A12"/>
        </linearGradient>
        <linearGradient id="neckwood" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3A2817"/>
          <stop offset="1" stop-color="#2C1E11"/>
        </linearGradient>
      </defs>

      <!-- tightening knobs: ebony paddles on short stems -->
      <g stroke-linecap="round">
        <% [80, 145, 210].each do |y| %>
          <rect x="56"  y="<%= y - 3 %>" width="20" height="6" rx="3" fill="#55402A"/>
          <rect x="184" y="<%= y - 3 %>" width="20" height="6" rx="3" fill="#55402A"/>
          <rect x="34"  y="<%= y - 15 %>" width="26" height="30" rx="12" fill="#2B1F15" stroke="#6B5334" stroke-width="1.5"/>
          <rect x="200" y="<%= y - 15 %>" width="26" height="30" rx="12" fill="#2B1F15" stroke="#6B5334" stroke-width="1.5"/>
        <% end %>
      </g>

      <!-- ebony head plate, cream binding, open-book crown -->
      <path d="M78 262 L68 58 Q68 36 80 32 Q94 20 108 26 Q122 30 128 40 L130 43 L132 40 Q138 30 152 26 Q166 20 180 32 Q192 36 192 58 L182 262 Z"
            fill="url(#ebony)" stroke="#C9B893" stroke-width="2" stroke-linejoin="round"/>

      <!-- the maker's mark -->
      <text x="130" y="74" text-anchor="middle" fill="var(--accent)"
            font-family="Snell Roundhand, Iowan Old Style, Palatino, serif" font-style="italic"
            font-size="34" font-weight="600">M</text>

      <!-- string posts on the face -->
      <g>
        <% [80, 145, 210].each do |y| %>
          <% [108, 152].each do |x| %>
            <circle cx="<%= x %>" cy="<%= y %>" r="9" fill="none" stroke="#55402A" stroke-width="1.5"/>
            <circle cx="<%= x %>" cy="<%= y %>" r="6" fill="#0F0A06" stroke="#6B5334" stroke-width="1.2"/>
            <circle cx="<%= x %>" cy="<%= y %>" r="2.2" fill="#D8C9A8"/>
          <% end %>
        <% end %>
      </g>

      <!-- neck -->
      <path d="M96 268 L164 268 L167 335 L93 335 Z" fill="url(#neckwood)" stroke="#2A1B10" stroke-width="1.5"/>

      <!-- strings: basses off the left posts, trebles off the right -->
      <g stroke="#E8D9B4" fill="none" stroke-linecap="round">
        <path d="M108 210 L102 266 L101 335" stroke-width="2.4" data-tuner-target="stringLine" data-name="E2"/>
        <path d="M108 145 L113 266 L112.5 335" stroke-width="2.0" data-tuner-target="stringLine" data-name="A2"/>
        <path d="M108 80  L124 266 L124 335" stroke-width="1.7" data-tuner-target="stringLine" data-name="D3"/>
        <path d="M152 80  L135 266 L135 335" stroke-width="1.4" data-tuner-target="stringLine" data-name="G3"/>
        <path d="M152 145 L146 266 L146.5 335" stroke-width="1.15" data-tuner-target="stringLine" data-name="B3"/>
        <path d="M152 210 L157 266 L158 335" stroke-width="0.95" data-tuner-target="stringLine" data-name="E4"/>
      </g>

      <!-- nut -->
      <rect x="94" y="262" width="72" height="8" rx="3" fill="#EBDCC0"/>
    </svg>

    <% [["D3", 146.83, "side-left",  "row-1"], ["A2", 110.0,  "side-left",  "row-2"],
        ["E2", 82.41,  "side-left",  "row-3"], ["G3", 196.0,  "side-right", "row-1"],
        ["B3", 246.94, "side-right", "row-2"], ["E4", 329.63, "side-right", "row-3"]].each do |name, frequency, side, row| %>
      <button type="button" class="tuner-string <%= side %> <%= row %>" aria-label="Tune the <%= name %> string"
              data-tuner-target="string" data-action="tuner#select"
              data-name="<%= name %>" data-frequency="<%= frequency %>"><%= name.first %></button>
    <% end %>
  </div>

  <p class="muted tuner-status" data-tuner-target="status">Starting the microphone…</p>
</div>
