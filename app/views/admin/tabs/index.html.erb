<% content_for :title, "Tabs · Admin · Malagueña" %>
<p class="eyebrow">Library</p>
<h1>Tabs</h1>

<div class="toolbar">
  <span class="muted"><%= pluralize(@tabs.size, "tab") %></span>
  <span class="spacer"></span>
  <%= link_to "+ New tab", new_admin_tab_path, class: "btn" %>
</div>

<div class="admin-table-head">
  <span>Title</span><span>Bars · meter</span><span>BPM</span><span>Used in</span><span></span>
</div>
<ul class="card-list admin-list">
  <% @tabs.each do |tab| %>
    <li class="card admin-row">
      <%= link_to tab.title, edit_admin_tab_path(tab), class: "tab-title admin-row-title" %>
      <span class="muted"><%= tab.bar_count %> · <%= tab.beats_per_bar %>/4</span>
      <span class="muted"><%= tab.default_bpm %></span>
      <span class="muted admin-used-in"><%= tab.segments.map { |s| s.routine.name }.uniq.to_sentence.presence || "—" %></span>
      <%= button_to "✕", admin_tab_path(tab), method: :delete, class: "btn btn-ghost admin-delete",
            form: { data: { turbo_confirm: "Delete #{tab.title}?" } } %>
    </li>
  <% end %>
</ul>
