<div class="segment-row card" data-nested-form-row data-controller="segment-fields">
  <div class="field-row">
    <div class="field">
      <%= f.label :kind, "Type" %>
      <%= f.select :kind, Segment::KIND_LABELS.invert.to_a,
            {}, data: { segment_fields_target: "kind", action: "segment-fields#refresh" } %>
    </div>
    <div class="field">
      <%= f.label :duration_minutes, "Minutes" %>
      <%= f.number_field :duration_minutes, min: 0.5, step: 0.5 %>
    </div>
    <div class="field-row" data-segment-fields-target="tabFields" style="flex: 2 1 260px; gap: 1rem;">
      <div class="field">
        <%= f.label :tab_id, "Tab" %>
        <%= f.collection_select :tab_id, Tab.order(:title), :id, :title, include_blank: "Pick a tab" %>
      </div>
      <div class="field">
        <%= f.label :bpm, "BPM" %>
        <%= f.number_field :bpm, min: 20, max: 300, placeholder: "tab default" %>
      </div>
    </div>
  </div>
  <div class="segment-row-foot">
    <%= f.hidden_field :position %>
    <%= f.hidden_field :_destroy %>
    <button class="btn btn-danger" data-action="nested-form#remove">Remove</button>
  </div>
</div>
