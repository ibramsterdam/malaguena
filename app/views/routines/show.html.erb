<% content_for :title, "#{@routine.name} · Malagueña" %>
<p class="eyebrow">Routine · <%= format_duration(@routine.total_seconds) %></p>
<h1><%= @routine.name %></h1>

<ul class="card-list">
  <% @routine.segments.each_with_index do |segment, index| %>
    <li class="card segment-line">
      <span class="segment-index"><%= index + 1 %></span>
      <span>
        <strong><%= segment.label %></strong>
        <span class="muted">
          <%= format_duration(segment.duration_seconds) %><% if segment.tab_practice? %> · <%= segment.effective_bpm %> BPM<% end %>
        </span>
      </span>
    </li>
  <% end %>
</ul>

<div class="toolbar">
  <%= link_to "Edit", edit_routine_path(@routine), class: "btn btn-ghost" %>
  <%= button_to "Delete", @routine, method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "Delete #{@routine.name}?" } %>
  <span class="spacer"></span>
  <%= link_to "All routines", routines_path, class: "muted" %>
</div>
