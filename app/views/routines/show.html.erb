<% content_for :title, "#{@routine.name} · Malagueña" %>
<%
  segment_data = @routine.segments.map do |segment|
    { label: segment.label, kind: segment.kind, seconds: segment.duration_seconds, bpm: segment.effective_bpm }
  end
%>

<div data-controller="routine-run" data-routine-run-segments-value="<%= segment_data.to_json %>">
  <p class="eyebrow">Routine · <%= format_duration(@routine.total_seconds) %></p>
  <h1><%= @routine.name %></h1>
  <p class="muted player-status" data-routine-run-target="status">Ready when you are.</p>

  <div class="player-grid">
    <aside>
      <ol class="segment-toc">
        <% @routine.segments.each_with_index do |segment, index| %>
          <li>
            <button type="button" class="segment-toc-row" data-routine-run-target="segment"
                    data-action="routine-run#jump" data-routine-run-index-param="<%= index %>">
              <span class="segment-toc-title">
                <span class="segment-index"><%= index + 1 %></span>
                <%= segment.label %>
              </span>
              <span class="segment-toc-dots" aria-hidden="true"></span>
              <span class="segment-toc-details">
                <%= format_duration(segment.duration_seconds) %><% if segment.tab_practice? %> · <%= segment.effective_bpm %> BPM<% end %>
              </span>
            </button>
          </li>
        <% end %>
      </ol>
    </aside>

    <section class="player-main">
      <div class="dials">
        <div class="card dial">
          <span class="dial-label">Time left</span>
          <span class="dial-big" data-routine-run-target="clock">00:00</span>
        </div>
        <div class="card dial" data-controller="metronome" data-routine-run-target="metronome">
          <span class="dial-label">Metronome</span>
          <span class="dial-big"><span data-metronome-target="bpm">80</span> <small>BPM</small></span>
          <div class="metro-dots dial-dots" data-metronome-target="dots" aria-hidden="true"></div>
        </div>
      </div>

      <% @routine.segments.each do |segment| %>
        <div data-routine-run-target="pane" hidden>
          <% if segment.tab_practice? && segment.tab %>
            <div class="engraved" data-controller="tab-player">
              <pre class="tab-sheet" data-tab-player-target="sheet"><%= segment.tab.body %></pre>
            </div>
          <% elsif segment.rest? %>
            <div class="card pane-calm">Shake out your hands. Breathe. The next segment starts on its own.</div>
          <% else %>
            <div class="card pane-calm">Free play — no sheet, no playhead. Just you and the guitar.</div>
          <% end %>
        </div>
      <% end %>

      <div class="toolbar" data-controller="transport">
        <button class="btn player-toggle" data-routine-run-target="toggle" data-action="routine-run#toggle">Start practice</button>
        <button class="btn btn-ghost" title="Restart" aria-label="Restart"
                data-action="transport#send" data-transport-action-param="restart">⟲</button>
        <button class="btn btn-ghost" title="Back a note" aria-label="Back a note"
                data-action="transport#send" data-transport-action-param="back">‹</button>
        <button class="btn btn-ghost" title="Forward a note" aria-label="Forward a note"
                data-action="transport#send" data-transport-action-param="forward">›</button>
        <button class="btn btn-ghost" data-action="routine-run#nudge" data-routine-run-amount-param="-5">−5</button>
        <button class="btn btn-ghost" data-action="routine-run#nudge" data-routine-run-amount-param="5">+5</button>
        <button class="btn btn-ghost" hidden data-transport-target="clear"
                data-action="transport#send" data-transport-action-param="clearloop">✕ loop</button>
      </div>
    </section>
  </div>
</div>
